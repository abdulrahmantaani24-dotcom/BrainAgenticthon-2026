# Auto-detect text files and normalise line endings to LF in the repo.
* text=auto

# Force these to always use LF (even on Windows checkouts):
*.py        text eol=lf
*.md        text eol=lf
*.toml      text eol=lf
*.yaml      text eol=lf
*.yml       text eol=lf
*.json      text eol=lf
*.cfg       text eol=lf
*.ini       text eol=lf
*.txt       text eol=lf
*.sh        text eol=lf
*.gitignore text eol=lf

# Binary files – never normalise
*.nii       binary
*.nii.gz    binary
*.dcm       binary
*.mnc       binary
*.nrrd      binary
*.mha       binary
*.mgz       binary
*.png       binary
*.jpg       binary
*.jpeg      binary
*.gif       binary
*.ico       binary
*.pt        binary
*.pth       binary
*.ckpt      binary
*.safetensors binary
*.h5        binary
*.hdf5      binary
*.onnx      binary
*.pb        binary
*.tflite    binary
